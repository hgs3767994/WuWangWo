{
  "name": "forget-me-not-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:web": "node scripts/build-web.mjs",
    "cap:sync": "npm run build:web && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "check": "node scripts/check.mjs",
    "test": "node scripts/smoke-test.mjs",
    "check:worker": "node --check workers/oauth/src/index.js",
    "test:worker": "node --test workers/oauth/test/index.test.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1"
  }
}
